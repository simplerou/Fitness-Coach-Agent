  "cards": [
    {
      "dot": "cyan",
      "title": "真正跑起来的路径",
      "items": [
        "浏览器 → web/src → FastAPI app/main.py → app/services → PostgreSQL",
        "36 个接口直接写在 main.py，services 是被调用的函数集合",
        "另挂 3 个 router：/api/shaping、/api/shaping/intelligence、/api/training"
      ]
    },
    {
      "dot": "rose",
      "title": "空壳与未接线",
      "items": [
        "api、models、schemas 各只有 3 个文件有实现，其余都是 0 字节",
        "decision、orchestration、tasks、tools 整个目录都是空占位",
        "alembic/versions 与 docker-compose.yml 同样为空"
      ]
    },
    {
      "dot": "amber",
      "title": "AI 与外部服务",
      "items": [
        "diet_agent.py → 通义千问 qwen-plus-latest",
        "exercise_knowledge.py → jieba BM25 + Chroma + RRF 混合检索",
        "boohee_food_service.py → 薄荷食物开放 API"
      ]
    },
    {
      "dot": "emerald",
      "title": "前端组织方式",
      "items": [
        "8 个 views 对应 8 条路由（含动作库与塑形）",
        "components 按业务域分目录：diet / plan / shaping / training / charts…",
        "api 与 stores 按同一批业务域拆分，命名一一对应"
      ]
    }
