# 本机 PostgreSQL 连接。请复制为 .env 并填写自己的密码；不要提交 .env。
# 若密码含 @、/、:、# 等 URL 特殊字符，需要先进行 URL 编码。
DATABASE_URL=postgresql+psycopg://fitness_app:替换为你的密码@127.0.0.1:5432/fitness_coach

# Optional: set COOKIE_SECURE=1 only when serving over HTTPS
COOKIE_SECURE=0

# 薄荷科学.AI 食物查询 API Key（只供后端使用，不要提交真实密钥）
BOOHEE_API_KEY=

# 通义千问模型配置（Key 只供后端使用；各 Agent 发送范围以页面说明为准）
DASHSCOPE_API_KEY=
DIET_AGENT_MODEL=qwen-plus
DIET_AGENT_TIMEOUT_SECONDS=120
SHAPING_AGENT_MODEL=qwen-plus
TRAINING_PLAN_AGENT_MODEL=qwen-plus
# Optional; used by the curator indexing script and consented hybrid retrieval.
EXERCISE_RAG_EMBEDDING_MODEL=qwen3.7-text-embedding
EXERCISE_RAG_CHROMA_PATH=backend/.chroma
EXERCISE_RAG_CHROMA_COLLECTION=fitness_exercise_knowledge

# Tavily 联网搜索（CRAG 本地资料不足且用户授权时才调用；请填写自己的 Key）
TAVILY_API_KEY=
